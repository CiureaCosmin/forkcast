# Copy to .env.local (git-ignored) to connect the app to Supabase. Without these the app runs in
# local mode: data stays on the device, with sample recipes and two fixed people.

# Local Supabase (npm run db:start): both values are printed by `npx supabase status`.
# Hosted project: Supabase dashboard → Project Settings → API (the URL and the publishable key).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your-key-here
